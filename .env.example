# Create a key in CodeRabbit: Settings -> Account -> API keys (key type: "User").
# Enterprise plan required. Never commit a real key.
CODERABBIT_API_KEY=

# Optional. Defaults to https://api.coderabbit.ai
CODERABBIT_API_BASE_URL=

# Optional. Only needed for workspace-scoped keys that span several organizations.
CODERABBIT_ORG_ID=
